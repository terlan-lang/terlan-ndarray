module ndarray.NanReductionTest.

import ndarray.Array.{concatenate, dispose, dtype_code, from_floats, from_ints, is_nan, live_count, reshape, shape, to_bools, to_floats, to_floats_cast}.
import ndarray.Creation.{linspace_steps}.
import ndarray.Numpy.{nanargmax_axes, nanargmin_axes, nancumprod, nancumprod_as, nancumprod_flat, nancumprod_flat_into, nancumprod_into, nancumsum, nancumsum_as, nancumsum_flat, nancumsum_flat_into, nancumsum_into, nanmax, nanmax_into, nanmean, nanmean_as, nanmean_into, nanmin, nanmin_into, nanprod, nanprod_as, nanprod_into, nanstd, nanstd_as, nanstd_into, nansum, nansum_as, nansum_into, nanvar, nanvar_as, nanvar_into}.

@test
pub nan_reductions_cover_axes_dtypes_outputs_and_all_nan_values(): Bool ->
    let start = from_floats([0.0], []);
    let stop = from_floats([1.0], []);
    let nan_scalar = linspace_steps(start, stop, 0, 1);
    let nan_vector = reshape(nan_scalar, [1]);
    let first = from_floats([1.0], [1]);
    let last = from_floats([3.0], [1]);
    let mixed = concatenate([first, nan_vector, last], 0);
    let sum = nansum(mixed, [], false);
    let product = nanprod(mixed, [], false);
    let mean = nanmean(mixed, [], false);
    let minimum = nanmin(mixed, [], false);
    let maximum = nanmax(mixed, [], false);
    let variance = nanvar(mixed, [], false, 0);
    let deviation = nanstd(mixed, [], false, 0);
    let typed_sum = nansum_as(mixed, [], false, 11);
    let typed_product = nanprod_as(mixed, [], false, 11);
    let typed_mean = nanmean_as(mixed, [], false, 11);
    let typed_variance = nanvar_as(mixed, [], false, 0, 11);
    let typed_deviation = nanstd_as(mixed, [], false, 0, 11);
    let minimum_index = nanargmin_axes(mixed, [0], false);
    let maximum_index = nanargmax_axes(mixed, [0], true);
    let scalar_destination = from_floats([0.0], []);
    nansum_into(scalar_destination, mixed, [], false);
    let sum_written = to_floats(scalar_destination) == [4.0];
    nanprod_into(scalar_destination, mixed, [], false);
    let product_written = to_floats(scalar_destination) == [3.0];
    nanmean_into(scalar_destination, mixed, [], false);
    let mean_written = to_floats(scalar_destination) == [2.0];
    nanmin_into(scalar_destination, mixed, [], false);
    let minimum_written = to_floats(scalar_destination) == [1.0];
    nanmax_into(scalar_destination, mixed, [], false);
    let maximum_written = to_floats(scalar_destination) == [3.0];
    nanvar_into(scalar_destination, mixed, [], false, 0);
    let variance_written = to_floats(scalar_destination) == [1.0];
    nanstd_into(scalar_destination, mixed, [], false, 0);
    let deviation_written = to_floats(scalar_destination) == [1.0];
    let all_nan_minimum = nanmin(nan_vector, [], false);
    let all_nan_mean = nanmean(nan_vector, [], false);
    let all_nan_minimum_mask = is_nan(all_nan_minimum);
    let all_nan_mean_mask = is_nan(all_nan_mean);
    let valid = to_floats(sum) == [4.0]
        and to_floats(product) == [3.0]
        and to_floats(mean) == [2.0]
        and to_floats(minimum) == [1.0]
        and to_floats(maximum) == [3.0]
        and to_floats(variance) == [1.0]
        and to_floats(deviation) == [1.0]
        and dtype_code(typed_sum) == 11
        and dtype_code(typed_product) == 11
        and dtype_code(typed_mean) == 11
        and dtype_code(typed_variance) == 11
        and dtype_code(typed_deviation) == 11
        and to_floats_cast(minimum_index) == [0.0]
        and shape(maximum_index) == [1]
        and to_floats_cast(maximum_index) == [2.0]
        and sum_written
        and product_written
        and mean_written
        and minimum_written
        and maximum_written
        and variance_written
        and deviation_written
        and to_bools(all_nan_minimum_mask) == [true]
        and to_bools(all_nan_mean_mask) == [true];
    dispose(all_nan_mean_mask);
    dispose(all_nan_minimum_mask);
    dispose(all_nan_mean);
    dispose(all_nan_minimum);
    dispose(scalar_destination);
    dispose(maximum_index);
    dispose(minimum_index);
    dispose(typed_deviation);
    dispose(typed_variance);
    dispose(typed_mean);
    dispose(typed_product);
    dispose(typed_sum);
    dispose(deviation);
    dispose(variance);
    dispose(maximum);
    dispose(minimum);
    dispose(mean);
    dispose(product);
    dispose(sum);
    dispose(mixed);
    dispose(last);
    dispose(first);
    dispose(nan_vector);
    dispose(nan_scalar);
    dispose(stop);
    dispose(start);
    valid and live_count() == 0.

@test
pub nan_cumulative_operations_cover_axes_flattening_integer_dtypes_and_outputs(): Bool ->
    let start = from_floats([0.0], []);
    let stop = from_floats([1.0], []);
    let nan_scalar = linspace_steps(start, stop, 0, 1);
    let nan_vector = reshape(nan_scalar, [1]);
    let first = from_floats([1.0], [1]);
    let last = from_floats([3.0], [1]);
    let mixed = concatenate([first, nan_vector, last], 0);
    let sums = nancumsum(mixed, 0);
    let products = nancumprod(mixed, -1);
    let flat_sums = nancumsum_flat(mixed);
    let flat_products = nancumprod_flat(mixed);
    let typed_sums = nancumsum_as(mixed, 0, 11);
    let typed_products = nancumprod_as(mixed, 0, 11);
    let sum_destination = from_floats([0.0, 0.0, 0.0], [3]);
    let product_destination = from_floats([0.0, 0.0, 0.0], [3]);
    nancumsum_into(sum_destination, mixed, 0);
    nancumprod_into(product_destination, mixed, 0);
    nancumsum_flat_into(sum_destination, mixed);
    nancumprod_flat_into(product_destination, mixed);
    let integers = from_ints([1, 2, 3], [3]);
    let integer_sums = nancumsum(integers, 0);
    let integer_products = nancumprod(integers, 0);
    let valid = to_floats(sums) == [1.0, 1.0, 4.0]
        and to_floats(products) == [1.0, 1.0, 3.0]
        and to_floats(flat_sums) == [1.0, 1.0, 4.0]
        and to_floats(flat_products) == [1.0, 1.0, 3.0]
        and dtype_code(typed_sums) == 11
        and dtype_code(typed_products) == 11
        and to_floats(sum_destination) == [1.0, 1.0, 4.0]
        and to_floats(product_destination) == [1.0, 1.0, 3.0]
        and dtype_code(integer_sums) == 2
        and dtype_code(integer_products) == 2
        and to_floats_cast(integer_sums) == [1.0, 3.0, 6.0]
        and to_floats_cast(integer_products) == [1.0, 2.0, 6.0];
    dispose(integer_products);
    dispose(integer_sums);
    dispose(integers);
    dispose(product_destination);
    dispose(sum_destination);
    dispose(typed_products);
    dispose(typed_sums);
    dispose(flat_products);
    dispose(flat_sums);
    dispose(products);
    dispose(sums);
    dispose(mixed);
    dispose(last);
    dispose(first);
    dispose(nan_vector);
    dispose(nan_scalar);
    dispose(stop);
    dispose(start);
    valid and live_count() == 0.
