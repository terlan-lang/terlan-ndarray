module ndarray.AbiTest.

import ndarray.Array.{add, byte_count, contiguous_code, device_type_code, dispose, dtype_code, from_bools, from_floats, from_ints, live_count, multiply, numel, rank, reshape, shape, strides, subtract, sum, to_bools, to_floats, to_ints, transpose}.

@test
pub owned_cpu_metadata_is_observable(): Bool ->
    let integers = from_ints([1, 2, 3, 4, 5, 6], [2, 3]);
    let integer_shape = shape(integers);
    let integer_ok = rank(integers) == 2 and
        integer_shape == [2, 3] and
        strides(integers) == [3, 1] and
        numel(integers) == 6 and
        byte_count(integers) == 48 and
        dtype_code(integers) == 2 and
        contiguous_code(integers) == 1 and
        device_type_code(integers) == 1 and
        to_ints(integers) == [1, 2, 3, 4, 5, 6];
    let booleans = from_bools([true, false, true], [3]);
    let boolean_ok = shape(booleans) == [3] and
        dtype_code(booleans) == 1 and
        to_bools(booleans) == [true, false, true];
    let first = 1.0 + 0.25;
    let float_values = [first, first + 1.0, first + 2.0, first + 3.0, first + 4.0, first + 5.0];
    let floats = from_floats(float_values, [2, 3]);
    let float_ok = shape(floats) == [2, 3] and
        strides(floats) == [3, 1] and
        byte_count(floats) == 48 and
        to_floats(floats) == float_values;
    let scalar = from_floats([2.5], []);
    let scalar_ok = rank(scalar) == 0 and numel(scalar) == 1 and
        dtype_code(scalar) == 3;
    dispose(integers);
    dispose(booleans);
    dispose(floats);
    dispose(scalar);
    integer_ok and boolean_ok and float_ok and scalar_ok and live_count() == 0.

@test
pub scalar_and_zero_dimension_layouts_are_exact(): Bool ->
    let scalar = from_floats([2.5], []);
    let empty = from_ints([], [2, 0, 3]);
    let layout_ok = shape(scalar) == [] and strides(scalar) == [] and
        to_floats(scalar) == [2.5] and shape(empty) == [2, 0, 3] and
        strides(empty) == [0, 3, 1] and numel(empty) == 0 and
        byte_count(empty) == 0 and to_ints(empty) == [];
    dispose(scalar);
    dispose(empty);
    layout_ok and live_count() == 0.

@test
pub owned_shape_operations_are_exact(): Bool ->
    let source = from_ints([1, 2, 3, 4, 5, 6], [2, 3]);
    let reshaped = reshape(source, [3, 2]);
    let transposed = transpose(reshaped, 0, -1);
    let valid = shape(reshaped) == [3, 2] and
        strides(reshaped) == [2, 1] and
        to_ints(reshaped) == [1, 2, 3, 4, 5, 6] and
        shape(transposed) == [2, 3] and
        strides(transposed) == [3, 1] and
        to_ints(transposed) == [1, 3, 5, 2, 4, 6];
    dispose(source);
    dispose(transposed);
    dispose(reshaped);
    valid and live_count() == 0.

@test
pub exact_shape_arithmetic_and_reductions_are_exact(): Bool ->
    let left = from_ints([1, -2, 3, -4], [2, 2]);
    let right = from_ints([5, 6, -7, -8], [2, 2]);
    let added = add(left, right);
    let subtracted = subtract(left, right);
    let multiplied = multiply(left, right);
    let row_sums = sum(left, [-1], 1);
    let total = sum(left, [], 0);
    let valid = to_ints(added) == [6, 4, -4, -12] and
        to_ints(subtracted) == [-4, -8, 10, 4] and
        to_ints(multiplied) == [5, -12, -21, 32] and
        shape(row_sums) == [2, 1] and
        to_ints(row_sums) == [-1, -1] and
        shape(total) == [] and to_ints(total) == [-2];
    dispose(total);
    dispose(left);
    dispose(added);
    dispose(right);
    dispose(multiplied);
    dispose(row_sums);
    dispose(subtracted);
    valid and live_count() == 0.
