/**
 * NumPy-compatible numerical completion operations.
 */
module ndarray.Numpy.

import ndarray.Array.{Array, CastingRule, concatenate, dispose, dtype_code, from_floats, from_ints, shape, zeros}.
import ndarray.Indexing.{take_indices_into, take_indices_mode}.
import std.collections.List.{concat, length}.

import type ndarray.Array.{ArrayOrder}.
import type std.vm.Bytes.

/**
 * Returns stable lexicographic indexes for stacked keys along one normalized key axis, using the final key as primary.
 */
@compiler.native {ndarray.numpy.lexsort}
pub lexsort(keys: Array, axis: Int): Array ->
    native.

/**
 * Provides NumPy-compatible allclose behavior.
 */
@compiler.native {ndarray.numpy.allclose}
pub allclose(
    lhs: Array,
    rhs: Array,
    relative_tolerance: Float,
    absolute_tolerance: Float,
    equal_nan: Bool,
): Bool ->
    native.

/**
 * Returns elementwise NumPy-compatible closeness.
 */
@compiler.native {ndarray.numpy.isclose}
pub isclose(
    lhs: Array,
    rhs: Array,
    relative_tolerance: Float,
    absolute_tolerance: Float,
    equal_nan: Bool,
): Array ->
    native.

