/**
 * Generated ABI-v1 bindings for owned contiguous CPU arrays.
 */

module ndarray.Array.

/** Opaque owned contiguous CPU array. */
pub opaque type Array.

/** Copies boolean values and shape into owned CPU storage. */
@compiler.native {ndarray.array.from_bools}
pub from_bools(values: List[Bool], shape: List[Int]): Array -> native.

/** Copies Int64 values and shape into owned CPU storage. */
@compiler.native {ndarray.array.from_ints}
pub from_ints(values: List[Int], shape: List[Int]): Array -> native.

/** Copies Float64 values and shape into owned CPU storage. */
@compiler.native {ndarray.array.from_floats}
pub from_floats(values: List[Float], shape: List[Int]): Array -> native.

/** Returns array rank. */
@compiler.native {ndarray.array.rank}
pub rank(array: Array): Int -> native.

/** Copies array shape into a Terlan list. */
@compiler.native {ndarray.array.shape}
pub shape(array: Array): List[Int] -> native.

/** Returns logical element count. */
@compiler.native {ndarray.array.numel}
pub numel(array: Array): Int -> native.

/** Copies canonical row-major element strides. */
@compiler.native {ndarray.array.strides}
pub strides(array: Array): List[Int] -> native.

/** Returns the checked contiguous storage byte count. */
@compiler.native {ndarray.array.byte_count}
pub byte_count(array: Array): Int -> native.

/** Returns the ABI-v1 dtype code. */
@compiler.native {ndarray.array.dtype_code}
pub dtype_code(array: Array): Int -> native.

/** Returns one for the ABI-v1 contiguous layout. */
@compiler.native {ndarray.array.contiguous_code}
pub contiguous_code(array: Array): Int -> native.

/** Returns the ABI-v1 CPU device code. */
@compiler.native {ndarray.array.device_type_code}
pub device_type_code(array: Array): Int -> native.

/** Returns an owned copy of Bool values. */
@compiler.native {ndarray.array.to_bools}
pub to_bools(array: Array): List[Bool] -> native.

/** Returns an owned copy of Int64 values. */
@compiler.native {ndarray.array.to_ints}
pub to_ints(array: Array): List[Int] -> native.

/** Returns an owned copy of Float64 values. */
@compiler.native {ndarray.array.to_floats}
pub to_floats(array: Array): List[Float] -> native.

/** Copies an array into an independently owned contiguous shape. */
@compiler.native {ndarray.array.reshape}
pub reshape(array: Array, shape: List[Int]): Array -> native.

/** Copies an array with two axes exchanged into contiguous storage. */
@compiler.native {ndarray.array.transpose}
pub transpose(array: Array, axis_a: Int, axis_b: Int): Array -> native.

/** Adds exact-shape numeric arrays without broadcasting. */
@compiler.native {ndarray.array.add}
pub add(lhs: Array, rhs: Array): Array -> native.

/** Subtracts exact-shape numeric arrays without broadcasting. */
@compiler.native {ndarray.array.subtract}
pub subtract(lhs: Array, rhs: Array): Array -> native.

/** Multiplies exact-shape numeric arrays without broadcasting. */
@compiler.native {ndarray.array.multiply}
pub multiply(lhs: Array, rhs: Array): Array -> native.

/** Reduces normalized axes; an empty axis list reduces all axes. */
@compiler.native {ndarray.array.sum}
pub sum(array: Array, axes: List[Int], keep_dims: Int): Array -> native.

/** Disposes an owned array exactly once. */
@compiler.native {ndarray.array.dispose}
pub dispose(array: Array): Unit -> native.

/** Returns live native allocations for lifecycle auditing. */
@compiler.native {ndarray.array.live_count}
pub live_count(): Int -> native.

