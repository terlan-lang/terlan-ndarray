/**
 * Generated ABI-v1 bindings for shared strided CPU arrays and owned materializations.
 */
module ndarray.Array.

import ndarray.ArrowArray.

import type std.vm.Bytes.

/**
 * Opaque CPU array with package-owned shared storage, shape, offset, and element strides.
 */
