/**
 * Samples uniform values in the half-open unit interval.
 */
pub random(stream: RandomStream, shape: List[Int] = [], dtype: Int = 3): Array ->
    uniform(stream, shape, 0.0, 1.0, dtype).

/**
 * Samples a broadcast-compatible uniform distribution from array parameters.
 */
pub uniform(stream: RandomStream, low: Array, high: Array, dtype: Int = 3): Array ->
    sample_broadcast(stream, [low, high], 0, dtype).

/**
 * Samples source values along one axis and replaces that axis with the requested shape.
 */
pub choice(
    stream: RandomStream,
    source: Array,
    shape: List[Int],
    probabilities: Array,
    replacement: Bool,
    axis: Int,
    shuffle: Bool,
): Array ->
    sample_choice_axis(stream, source, shape, probabilities, replacement, axis, shuffle).

/**
 * Samples source values uniformly along one axis.
 */
pub choice(
    stream: RandomStream,
    source: Array,
    shape: List[Int],
    replacement: Bool,
    axis: Int,
    shuffle: Bool,
): Array ->
    sample_choice_uniform_axis(stream, source, shape, replacement, axis, shuffle).

/**
 * Samples uniformly from the integer population starting at zero.
 */
pub choice(stream: RandomStream, population: Int, shape: List[Int], replacement: Bool): Array ->
    let source = arange(population);
    let output = sample_choice_uniform_axis(stream, source, shape, replacement, 0, true);
    ndarray.Array.dispose(source);
    output.

