/**
 * Samples broadcast-compatible bounded integers with optional inclusive upper bounds.
 */
pub integers(
    stream: RandomStream,
    low: Array,
    high: Array,
    dtype: Int = 2,
    endpoint: Bool = false,
): Array ->
    if {
        endpoint -> sample_broadcast(stream, [low, high], 30, dtype);
        true -> sample_broadcast(stream, [low, high], 29, dtype)
    }.

/**
 * Samples one requested shape of bounded integers with optional inclusive upper bounds.
 */
pub integers(
    stream: RandomStream,
    shape: List[Int],
    low: Int,
    high: Int,
    dtype: Int,
    endpoint: Bool,
): Array ->
    let lows = full_int(shape, low, 2);
    let highs = full_int(shape, high, 2);
    let output = integers(stream, lows, highs, dtype, endpoint);
    ndarray.Array.dispose(highs);
    ndarray.Array.dispose(lows);
    output.
