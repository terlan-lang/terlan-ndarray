/**
 * Generated bindings for an owned deterministic ndarray random stream.
 */
module ndarray.RandomStream.

import ndarray.Array.

/**
 * Thread-confined ChaCha8 random state advanced explicitly by package operations.
 */
pub opaque type RandomStream.

/**
 * Creates a deterministic ChaCha8 stream at an explicit seed.
 */
@compiler.native {ndarray.random_stream.new}
pub new(seed: Int): RandomStream ->
    native.

/**
 * Samples one package-private broadcast distribution family.
 */
@compiler.native {ndarray.random_stream.sample_broadcast}
sample_broadcast(
    stream: RandomStream,
    parameter_handles: List[Array],
    distribution: Int,
    dtype: Int,
): Array ->
    native.

/**
 * Advances the stream while creating uniform floating samples.
 */
@compiler.native {ndarray.random_stream.uniform}
pub uniform(stream: RandomStream, shape: List[Int], low: Float, high: Float, dtype: Int): Array ->
    native.

/**
 * Advances the stream while atomically filling a C-contiguous floating destination with uniform samples in the half-open interval from zero through one.
 */
@compiler.native {ndarray.random_stream.uniform_into}
pub uniform_into(stream: RandomStream, destination: Array): Unit ->
    native.

