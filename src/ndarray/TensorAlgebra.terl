/**
 * General tensor contraction, Einstein summation, Kronecker products, and cross products.
 */
module ndarray.TensorAlgebra.

import ndarray.Array.

import type ndarray.Array.{ArrayOrder}.

/**
 * Contracts two tensors over paired normalized axis lists.
 */
@compiler.native {ndarray.array.tensordot}
pub tensordot(lhs: Array, rhs: Array, lhs_axes: List[Int], rhs_axes: List[Int]): Array ->
    native.

/**
 * Computes a NumPy-compatible rank-padded Kronecker product.
 */
@compiler.native {ndarray.array.kron}
pub kron(lhs: Array, rhs: Array): Array ->
    native.

/**
 * Computes a three-component vector cross product along one normalized axis.
 */
@compiler.native {ndarray.array.cross}
pub cross(lhs: Array, rhs: Array, axis: Int): Array ->
    native.

/**
 * Executes an Einstein summation expression over one or more arrays.
 */
@compiler.native {ndarray.array.einsum}
pub einsum(operands: List[Array], equation: String): Array ->
    native.

/**
 * Executes Einstein summation and atomically writes the result into an exactly shaped destination.
 */
@compiler.native {ndarray.array.einsum_into}
pub einsum_into(destination: Array, operands: List[Array], equation: String): Unit ->
    native.

/**
 * Executes Einstein summation using an explicit C, Fortran, keep, or any output-order policy.
 */
@compiler.native {ndarray.array.einsum_ordered}
pub einsum_ordered(operands: List[Array], equation: String, order: Int): Array ->
    native.

/**
 * Executes Einstein summation using a typed output memory-order policy.
 */
pub einsum(operands: List[Array], equation: String, order: ArrayOrder): Array ->
    einsum_ordered(
        operands,
        equation,
        case order {
            ArrayOrder.C -> 0;
            ArrayOrder.FORTRAN -> 1;
            ArrayOrder.KEEP -> 2;
            ArrayOrder.ANY -> 3
        },
    ).
