//! Chebyshev polynomial algebra and numerical methods.

module ndarray.Chebyshev.

/// Converts coefficients to the power basis.

pub cheb2poly(coefficients: ndarray.Array): ndarray.Array.

/// Adds coefficient vectors.

pub chebadd(lhs: ndarray.Array, rhs: ndarray.Array): ndarray.Array.

/// Builds a companion matrix.

pub chebcompanion(coefficients: ndarray.Array): ndarray.Array.

/// Differentiates coefficients.

pub chebder(coefficients: ndarray.Array, order: Int): ndarray.Array.

/// Differentiates Chebyshev coefficient lanes along an axis with derivative scaling.

pub chebder(coefficients: ndarray.Array, order: Int, scale: Float, axis: Int): ndarray.Array.

/// Returns quotient and remainder.

pub chebdiv(lhs: ndarray.Array, rhs: ndarray.Array): List[ndarray.Array].

/// Fits coefficients to samples.

pub chebfit(coordinates: ndarray.Array, values: ndarray.Array, degree: Int): ndarray.Array.

/// Fits selected Chebyshev degrees to scalar or matrix-valued samples.

pub chebfit(coordinates: ndarray.Array, values: ndarray.Array, degrees: ndarray.Array): ndarray.Array.

/// Fits selected Chebyshev degrees using sample weights.

pub chebfit(coordinates: ndarray.Array, values: ndarray.Array, degrees: ndarray.Array, weights: ndarray.Array): ndarray.Array.

/// Builds coefficients from roots.

pub chebfromroots(roots: ndarray.Array): ndarray.Array.

/// Returns Gaussian quadrature nodes and weights.

pub chebgauss(degree: Int): ndarray.Array.

/// Evaluates over a two-dimensional Cartesian grid.

pub chebgrid2d(x: ndarray.Array, y: ndarray.Array, coefficients: ndarray.Array): ndarray.Array.

/// Evaluates over a three-dimensional Cartesian grid.

pub chebgrid3d(x: ndarray.Array, y: ndarray.Array, z: ndarray.Array, coefficients: ndarray.Array): ndarray.Array.

/// Integrates coefficients.

pub chebint(coefficients: ndarray.Array, order: Int, constant: Float): ndarray.Array.

/// Integrates Chebyshev coefficient lanes along an axis with constants, a lower bound, and scaling.

pub chebint(coefficients: ndarray.Array, order: Int, constants: ndarray.Array, lower_bound: Float, scale: Float, axis: Int): ndarray.Array.

/// Interpolates sampled values in the Chebyshev basis.

pub chebinterpolate(values: ndarray.Array): ndarray.Array.

/// Builds coefficients for offset plus scale times x.

pub chebline(offset: Float, scale: Float): ndarray.Array.

/// Multiplies coefficient vectors.

pub chebmul(lhs: ndarray.Array, rhs: ndarray.Array): ndarray.Array.

/// Multiplies coefficients by x.

pub chebmulx(coefficients: ndarray.Array): ndarray.Array.

/// Raises coefficients to a nonnegative power.

pub chebpow(coefficients: ndarray.Array, exponent: Int): ndarray.Array.

/// Returns first-kind Chebyshev points.

pub chebpts1(count: Int): ndarray.Array.

/// Returns second-kind Chebyshev points.

pub chebpts2(count: Int): ndarray.Array.

/// Returns polynomial roots.

pub chebroots(coefficients: ndarray.Array): ndarray.Array.

/// Subtracts coefficient vectors.

pub chebsub(lhs: ndarray.Array, rhs: ndarray.Array): ndarray.Array.

/// Removes insignificant high-order coefficients.

pub chebtrim(coefficients: ndarray.Array, tolerance: Float): ndarray.Array.

/// Evaluates coefficients.

pub chebval(coordinates: ndarray.Array, coefficients: ndarray.Array): ndarray.Array.

/// Evaluates Chebyshev coefficient tensors with Cartesian or broadcast semantics.

pub chebval(coordinates: ndarray.Array, coefficients: ndarray.Array, tensor: Bool): ndarray.Array.

/// Evaluates a two-dimensional coefficient tensor.

pub chebval2d(x: ndarray.Array, y: ndarray.Array, coefficients: ndarray.Array): ndarray.Array.

/// Evaluates a three-dimensional coefficient tensor.

pub chebval3d(x: ndarray.Array, y: ndarray.Array, z: ndarray.Array, coefficients: ndarray.Array): ndarray.Array.

/// Builds a Vandermonde matrix.

pub chebvander(coordinates: ndarray.Array, degree: Int): ndarray.Array.

/// Builds a two-dimensional Vandermonde matrix.

pub chebvander2d(x: ndarray.Array, y: ndarray.Array, x_degree: Int, y_degree: Int): ndarray.Array.

/// Builds a three-dimensional Vandermonde matrix.

pub chebvander3d(x: ndarray.Array, y: ndarray.Array, z: ndarray.Array, x_degree: Int, y_degree: Int, z_degree: Int): ndarray.Array.

/// Evaluates the orthogonality weight function.

pub chebweight(coordinates: ndarray.Array): ndarray.Array.

/// Converts power coefficients to the cheb basis.

pub poly2cheb(coefficients: ndarray.Array): ndarray.Array.
