pub packbits(array: ndarray.Array, bit_order: Int): ndarray.Array.

/// Packs truth values into UInt8 bytes along one normalized axis.

pub packbits_axis(array: ndarray.Array, axis: Int, bit_order: Int): ndarray.Array.

/// Provides NumPy-compatible pad behavior.

pub pad(array: ndarray.Array, leading: List[Int], trailing: List[Int], value: Float): ndarray.Array.

/// Atomically writes one percentile into an exactly shaped writable destination.

pub percentile_into(destination: ndarray.Array, array: ndarray.Array, percentile: Float, axes: List[Int], keep_dims: Int, interpolation: Int): Unit.

/// Atomically writes multiple percentiles into an exactly shaped writable destination.

pub percentiles_into(destination: ndarray.Array, array: ndarray.Array, percentiles: List[Float], axes: List[Int], keep_dims: Int, interpolation: Int): Unit.

/// Provides NumPy-compatible place behavior.

pub place(array: ndarray.Array, mask: ndarray.Array, values: ndarray.Array): Unit.

/// Provides NumPy-compatible putmask behavior.

pub putmask(array: ndarray.Array, mask: ndarray.Array, values: ndarray.Array): Unit.

/// Atomically writes one quantile into an exactly shaped writable destination.

pub quantile_into(destination: ndarray.Array, array: ndarray.Array, quantile: Float, axes: List[Int], keep_dims: Int, interpolation: Int): Unit.

/// Atomically writes multiple quantiles into an exactly shaped writable destination.

pub quantiles_into(destination: ndarray.Array, array: ndarray.Array, quantiles: List[Float], axes: List[Int], keep_dims: Int, interpolation: Int): Unit.

