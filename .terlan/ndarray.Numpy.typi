pub ravel_multi_index(coordinates: ndarray.Array, dimensions: List[Int], modes: List[RavelMode] = [RavelMode.RAISE], order: ndarray.Array.ArrayOrder = ArrayOrder.C): ndarray.Array.

/// Provides NumPy-compatible real behavior.

pub real(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible real if close behavior.

pub real_if_close(array: ndarray.Array, tolerance: Float): ndarray.Array.

/// Writes reciprocals into an exact-shape destination after staging aliased input.

pub reciprocal_into(destination: ndarray.Array, array: ndarray.Array): Unit.

/// Writes reciprocals where a Bool mask is true while preserving masked destination elements.

pub reciprocal_where_into(destination: ndarray.Array, array: ndarray.Array, mask: ndarray.Array): Unit.

/// Provides NumPy-compatible row stack behavior.

pub row_stack(arrays: List[ndarray.Array]): ndarray.Array.

/// Provides NumPy-compatible select behavior.

pub select(conditions: List[ndarray.Array], choices: List[ndarray.Array], default_value: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible shares memory behavior.

pub shares_memory(lhs: ndarray.Array, rhs: ndarray.Array): Bool.

/// Returns exact memory overlap within the supplied work budget, failing when finite work is exhausted; negative one selects unlimited exact work.

pub shares_memory_with_work(lhs: ndarray.Array, rhs: ndarray.Array, max_work: Int): Bool.

/// Provides NumPy-compatible sinc behavior.

pub sinc(array: ndarray.Array): ndarray.Array.

/// Returns a read-only shared sliding-window view, using every axis when axes is empty.

pub sliding_window_view(array: ndarray.Array, window_shape: List[Int], axes: List[Int] = []): ndarray.Array.

/// Provides NumPy-compatible sort complex behavior.

pub sort_complex(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible spacing behavior.

pub spacing(array: ndarray.Array): ndarray.Array.

/// Takes values with an integer index Array while preserving every index dimension.

pub take(array: ndarray.Array, indices: ndarray.Array, axis: Int, mode: TakeMode = TakeMode.RAISE): ndarray.Array.

/// Atomically writes a shaped `take` result into an exact destination Array.

pub take_into(destination: ndarray.Array, array: ndarray.Array, indices: ndarray.Array, axis: Int, mode: TakeMode = TakeMode.RAISE): Unit.

/// Provides NumPy-compatible tril indices behavior.

pub tril_indices(rows: Int, offset: Int = 0, columns: Int = - 1): ndarray.Array.

/// Provides NumPy-compatible tril indices from behavior.

pub tril_indices_from(array: ndarray.Array, offset: Int = 0): ndarray.Array.

/// Provides NumPy-compatible trim zeros behavior.

pub trim_zeros(array: ndarray.Array, mode: Int): ndarray.Array.

/// Provides NumPy-compatible triu indices behavior.

pub triu_indices(rows: Int, offset: Int = 0, columns: Int = - 1): ndarray.Array.

/// Provides NumPy-compatible triu indices from behavior.

pub triu_indices_from(array: ndarray.Array, offset: Int = 0): ndarray.Array.

/// Provides NumPy-compatible trunc behavior.

pub trunc(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible unique behavior.

pub unique(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible unpackbits behavior.

pub unpackbits(array: ndarray.Array, count: Int, bit_order: Int): ndarray.Array.

/// Unpacks every available flattened UInt8 bit.

pub unpackbits_all(array: ndarray.Array, bit_order: Int): ndarray.Array.

/// Unpacks a counted number of UInt8 bits along one normalized axis.

pub unpackbits_axis(array: ndarray.Array, axis: Int, count: Int, bit_order: Int): ndarray.Array.

/// Unpacks every available UInt8 bit along one normalized axis.

pub unpackbits_axis_all(array: ndarray.Array, axis: Int, bit_order: Int): ndarray.Array.

/// Converts flat indexes into coordinate arrays with explicit memory order.

pub unravel_index(indexes: ndarray.Array, dimensions: List[Int], order: ndarray.Array.ArrayOrder = ArrayOrder.C): List[ndarray.Array].

/// Unwraps a real-valued signal using an explicit discontinuity threshold.

pub unwrap_discontinuity(array: ndarray.Array, period: Float, discontinuity: Float, axis: Int): ndarray.Array.

/// Unwraps using integral period arithmetic and preserves integral semantics.

pub unwrap_integer_period(array: ndarray.Array, period: Int, discontinuity: Int, axis: Int): ndarray.Array.

/// Provides NumPy-compatible vsplit behavior.

pub vsplit(array: ndarray.Array, sections: Int): List[ndarray.Array].

/// Provides NumPy-compatible vstack behavior.

pub vstack(arrays: List[ndarray.Array]): ndarray.Array.
