//! NumPy-compatible numerical completion operations.

module ndarray.Numpy.

/// Represents the directly typed block-tree forms admitted by `block`.

pub type Block =
    ndarray.Array
  | List[ndarray.Array]
  | List[List[ndarray.Array]]
  | List[List[List[ndarray.Array]]].

/// Selects a NumPy-compatible automatic histogram bin estimator.

pub type HistogramEstimator: Int =
    SQUARE_ROOT = 0
  | STURGES = 1
  | RICE = 2
  | SCOTT = 3
  | STONE = 4
  | DOANE = 5
  | FREEDMAN_DIACONIS = 6
  | AUTO = 7.

/// Selects Cartesian `xy` or matrix `ij` coordinate placement for `meshgrid`.

pub type MeshIndexing: Int =
    XY = 0
  | IJ = 1.

/// Selects how out-of-bounds coordinates are handled by `ravel_multi_index`.

pub type RavelMode: Int =
    RAISE = 0
  | WRAP = 1
  | CLIP = 2.

/// Selects how `take` handles indexes outside the selected axis.

pub type TakeMode: Int =
    RAISE = 0
  | WRAP = 1
  | CLIP = 2.

/// Selects the triangular masking rule used by `mask_indices`.

pub type TriangleMask: Int =
    LOWER = 0
  | UPPER = 1.

/// Writes magnitudes into an exact-shape destination after staging aliased input.

pub absolute_into(destination: ndarray.Array, array: ndarray.Array): Unit.

/// Applies sequential unbuffered addition at rank-one integer indexes with broadcast values and stable aliases.

pub add_at(array: ndarray.Array, indexes: ndarray.Array, values: ndarray.Array): Unit.

/// Writes a broadcast addition into an exact-shape destination after staging all aliased inputs.

pub add_into(destination: ndarray.Array, lhs: ndarray.Array, rhs: ndarray.Array): Unit.

/// Returns segmented addition reductions beginning at each rank-one integer index along an axis.

pub add_reduceat(array: ndarray.Array, indexes: ndarray.Array, axis: Int): ndarray.Array.

/// Writes segmented addition reductions into an exact-shape destination after staging aliased inputs.

pub add_reduceat_into(destination: ndarray.Array, array: ndarray.Array, indexes: ndarray.Array, axis: Int): Unit.

/// Writes broadcast sums where a Bool mask is true while preserving masked destination elements and staging aliases.

pub add_where_into(destination: ndarray.Array, lhs: ndarray.Array, rhs: ndarray.Array, mask: ndarray.Array): Unit.

/// Provides NumPy-compatible alen behavior.

pub alen(array: ndarray.Array): Int.

/// Provides NumPy-compatible allclose behavior.

pub allclose(lhs: ndarray.Array, rhs: ndarray.Array, relative_tolerance: Float, absolute_tolerance: Float, equal_nan: Bool): Bool.

/// Provides NumPy-compatible angle behavior.

pub angle(array: ndarray.Array, degrees: Bool): ndarray.Array.

/// Provides NumPy-compatible append behavior.

pub append(array: ndarray.Array, values: ndarray.Array, axis: Int): ndarray.Array.

/// Provides NumPy-compatible array equal behavior.

pub array_equal(lhs: ndarray.Array, rhs: ndarray.Array): Bool.

/// Returns strict equality while treating paired NaNs as equal.

pub array_equal_nan(lhs: ndarray.Array, rhs: ndarray.Array): Bool.

/// Provides NumPy-compatible array equiv behavior.

pub array_equiv(lhs: ndarray.Array, rhs: ndarray.Array): Bool.

/// Returns a read-only shared view with an explicit shape and element strides.

pub as_strided(array: ndarray.Array, shape: List[Int], strides: List[Int]): ndarray.Array.

/// Provides NumPy-compatible asarray chkfinite behavior.

pub asarray_chkfinite(array: ndarray.Array): ndarray.Array.

/// Returns a finite-only copy in an explicit dtype and memory order.

pub asarray_chkfinite(array: ndarray.Array, requested_dtype: Int, order: Int): ndarray.Array.

/// Provides NumPy-compatible asfarray behavior.

pub asfarray(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible average behavior.

pub average(array: ndarray.Array, axes: List[Int], keep_dims: Bool): ndarray.Array.

/// Returns an average weighted by a same-shape array or one-dimensional axis weights.

pub average_weighted(array: ndarray.Array, weights: ndarray.Array, axes: List[Int], keep_dims: Bool): ndarray.Array.

/// Returns a weighted average followed by its broadcast weight sum.

pub average_weighted_with_sum(array: ndarray.Array, weights: ndarray.Array, axes: List[Int], keep_dims: Bool): List[ndarray.Array].

/// Returns an unweighted average followed by its broadcast reduction cardinality.

pub average_with_sum(array: ndarray.Array, axes: List[Int], keep_dims: Bool): List[ndarray.Array].

/// Provides NumPy-compatible bartlett behavior.

pub bartlett(length: Int): ndarray.Array.

/// Counts occurrences of each nonnegative integer value.

pub bincount(values: ndarray.Array, minimum_length: Int = 0): ndarray.Array.

/// Provides NumPy-compatible bitwise not behavior.

pub bitwise_not(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible blackman behavior.

pub blackman(length: Int): ndarray.Array.

/// Copies one array through NumPy-compatible block semantics.

pub block(value: ndarray.Array): ndarray.Array.

/// Assembles a one-level block list.

pub block(values: List[ndarray.Array]): ndarray.Array.

/// Assembles a two-level block tree.

pub block(rows: List[List[ndarray.Array]]): ndarray.Array.

/// Assembles a three-level block tree.

pub block(planes: List[List[List[ndarray.Array]]]): ndarray.Array.

/// Assembles an arbitrary-depth block tree from leaves and validated prefix tokens.

pub block_encoded(values: List[ndarray.Array], layout: List[Int]): ndarray.Array.

/// Provides NumPy-compatible broadcast arrays behavior.

pub broadcast_arrays(first: ndarray.Array, remaining: List[ndarray.Array]): List[ndarray.Array].

/// Provides NumPy-compatible broadcast shapes behavior.

pub broadcast_shapes(lhs: List[Int], rhs: List[Int]): ndarray.Array.

/// Provides NumPy-compatible column stack behavior.

pub column_stack(arrays: List[ndarray.Array]): ndarray.Array.

/// Provides NumPy-compatible convolve behavior.

pub convolve(lhs: ndarray.Array, rhs: ndarray.Array, mode: Int): ndarray.Array.

/// Provides NumPy-compatible copyto behavior.

pub copyto(destination: ndarray.Array, source: ndarray.Array): Unit.

/// Broadcasts and copies values under an explicit NumPy-compatible casting rule.

pub copyto(destination: ndarray.Array, source: ndarray.Array, casting: Int): Unit.

/// Broadcasts a source and truth mask before copying selected values under an explicit casting rule.

pub copyto(destination: ndarray.Array, source: ndarray.Array, mask: ndarray.Array, casting: Int): Unit.

/// Broadcasts a source and truth mask before copying selected values.

pub copyto_where(destination: ndarray.Array, source: ndarray.Array, mask: ndarray.Array, casting: ndarray.Array.CastingRule): Unit.

/// Broadcasts and copies values under an explicit numerical casting rule.

pub copyto_with_casting(destination: ndarray.Array, source: ndarray.Array, casting: ndarray.Array.CastingRule): Unit.

/// Provides NumPy-compatible correlate behavior.

pub correlate(lhs: ndarray.Array, rhs: ndarray.Array, mode: Int): ndarray.Array.

/// Returns correlation coefficients after appending variables from a second observation array.

pub correlation_pair(array: ndarray.Array, other: ndarray.Array, row_variables: Int, dtype: Int): ndarray.Array.

/// Returns correlation coefficients in the requested floating-point or complex dtype.

pub correlation_typed(array: ndarray.Array, row_variables: Int, dtype: Int): ndarray.Array.

/// Returns covariance with nonnegative relative observation weights.

pub covariance_analytic_weighted(array: ndarray.Array, analytic_weights: ndarray.Array, row_variables: Int, correction: Int, dtype: Int): ndarray.Array.

/// Returns covariance with nonnegative integral observation frequencies.

pub covariance_frequency_weighted(array: ndarray.Array, frequency_weights: ndarray.Array, row_variables: Int, correction: Int, dtype: Int): ndarray.Array.

/// Returns covariance after appending variables from a second observation array.

pub covariance_pair(array: ndarray.Array, other: ndarray.Array, row_variables: Int, correction: Int, dtype: Int): ndarray.Array.

/// Returns paired covariance with combined observation weights.

pub covariance_pair_weighted(array: ndarray.Array, other: ndarray.Array, frequency_weights: ndarray.Array, analytic_weights: ndarray.Array, row_variables: Int, correction: Int, dtype: Int): ndarray.Array.

/// Returns covariance in the requested floating-point or complex dtype.

pub covariance_typed(array: ndarray.Array, row_variables: Int, correction: Int, dtype: Int): ndarray.Array.

/// Returns covariance with combined frequency and analytic observation weights.

pub covariance_weighted(array: ndarray.Array, frequency_weights: ndarray.Array, analytic_weights: ndarray.Array, row_variables: Int, correction: Int, dtype: Int): ndarray.Array.

/// Provides NumPy-compatible delete behavior.

pub delete(array: ndarray.Array, indexes: List[Int]): ndarray.Array.

/// Deletes normalized integer indexes along one axis.

pub delete(array: ndarray.Array, indexes: List[Int], axis: Int): ndarray.Array.

/// Deletes positions selected by an exact-length Bool mask along one axis.

pub delete(array: ndarray.Array, mask: ndarray.Array, axis: Int): ndarray.Array.

/// Extracts a matrix diagonal view or constructs a dtype-preserving diagonal matrix from a vector.

pub diag(array: ndarray.Array, offset: Int = 0): ndarray.Array.

/// Provides NumPy-compatible diag indices behavior.

pub diag_indices(size: Int, rank: Int): ndarray.Array.

/// Provides NumPy-compatible diag indices from behavior.

pub diag_indices_from(array: ndarray.Array): ndarray.Array.

/// Returns repeated differences after appending compatible values along one axis.

pub difference_append(array: ndarray.Array, append: ndarray.Array, order: Int, axis: Int): ndarray.Array.

/// Returns repeated differences after prepending compatible values along one axis.

pub difference_prepend(array: ndarray.Array, prepend: ndarray.Array, order: Int, axis: Int): ndarray.Array.

/// Returns repeated differences with compatible values on both ends of one axis.

pub difference_surround(array: ndarray.Array, prepend: ndarray.Array, append: ndarray.Array, order: Int, axis: Int): ndarray.Array.

/// Provides NumPy-compatible divmod behavior.

pub divmod(lhs: ndarray.Array, rhs: ndarray.Array): List[ndarray.Array].

/// Provides NumPy-compatible dsplit behavior.

pub dsplit(array: ndarray.Array, sections: Int): List[ndarray.Array].

/// Provides NumPy-compatible dstack behavior.

pub dstack(arrays: List[ndarray.Array]): ndarray.Array.

/// Provides NumPy-compatible ediff1d behavior.

pub ediff1d(array: ndarray.Array): ndarray.Array.

/// Writes a scalar across a diagonal, optionally wrapping through tall matrices.

pub fill_diagonal(array: ndarray.Array, value: Float, wrap: Bool = false): Unit.

/// Provides NumPy-compatible fix behavior.

pub fix(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible float power behavior.

pub float_power(lhs: ndarray.Array, rhs: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible fmod behavior.

pub fmod(lhs: ndarray.Array, rhs: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible frombuffer behavior.

pub frombuffer(bytes: std.vm.Bytes): ndarray.Array.

/// Provides NumPy-compatible full behavior.

pub full(shape: List[Int], value: Float): ndarray.Array.

/// Creates an array by broadcasting an Array-valued fill pattern.

pub full_from(shape: List[Int], fill_values: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible full like behavior.

pub full_like(array: ndarray.Array, value: Float): ndarray.Array.

/// Returns one uniform-spacing gradient for every source axis.

pub gradient_all(array: ndarray.Array, spacing: Float, edge_order: Int): List[ndarray.Array].

/// Returns gradients for selected axes using scalar or coordinate spacing arrays.

pub gradient_axes(array: ndarray.Array, spacings: List[ndarray.Array], axes: List[Int], edge_order: Int): List[ndarray.Array].

/// Returns a gradient along one axis using rank-one sample coordinates.

pub gradient_coordinates(array: ndarray.Array, coordinates: ndarray.Array, axis: Int, edge_order: Int): ndarray.Array.

/// Returns a uniform-spacing gradient with first- or second-order boundaries.

pub gradient_edge(array: ndarray.Array, spacing: Float, axis: Int, edge_order: Int): ndarray.Array.

/// Returns gradients for selected axes using one scalar spacing per axis.

pub gradient_uniform_axes(array: ndarray.Array, spacings: List[Float], axes: List[Int], edge_order: Int): List[ndarray.Array].

/// Provides NumPy-compatible hamming behavior.

pub hamming(length: Int): ndarray.Array.

/// Provides NumPy-compatible hanning behavior.

pub hanning(length: Int): ndarray.Array.

/// Provides NumPy-compatible heaviside behavior.

pub heaviside(lhs: ndarray.Array, zero_value: ndarray.Array): ndarray.Array.

/// Builds a one-dimensional histogram with an inferred finite range.

pub histogram(array: ndarray.Array, bins: Int = 10, density: Bool = false): List[ndarray.Array].

/// Builds a two-dimensional histogram with equal bin counts and inferred axis ranges.

pub histogram2d(x: ndarray.Array, y: ndarray.Array, bins: Int = 10, density: Bool = false): List[ndarray.Array].

/// Builds a two-dimensional histogram from explicit edge vectors.

pub histogram2d_edges(x: ndarray.Array, y: ndarray.Array, x_edges: ndarray.Array, y_edges: ndarray.Array, density: Bool = false): List[ndarray.Array].

/// Builds a two-dimensional histogram with explicit per-axis counts and ranges.

pub histogram2d_range(x: ndarray.Array, y: ndarray.Array, x_bins: Int, y_bins: Int, minima: ndarray.Array, maxima: ndarray.Array, density: Bool = false): List[ndarray.Array].

/// Builds a histogram with explicit x edges and uniform y bins.

pub histogram2d_x_edges(x: ndarray.Array, y: ndarray.Array, x_edges: ndarray.Array, y_bins: Int, y_lower: Float, y_upper: Float, density: Bool = false): List[ndarray.Array].

/// Builds a histogram with uniform x bins and explicit y edges.

pub histogram2d_y_edges(x: ndarray.Array, y: ndarray.Array, x_bins: Int, x_lower: Float, x_upper: Float, y_edges: ndarray.Array, density: Bool = false): List[ndarray.Array].

/// Returns inferred fixed-count histogram edges.

pub histogram_bin_edges(array: ndarray.Array, bins: Int = 10): ndarray.Array.

/// Returns estimator-selected histogram edges.

pub histogram_bin_edges_estimator(array: ndarray.Array, estimator: HistogramEstimator): ndarray.Array.

/// Builds a one-dimensional histogram from explicit increasing edges.

pub histogram_edges(array: ndarray.Array, edges: ndarray.Array, density: Bool = false): List[ndarray.Array].

/// Builds a histogram using a typed automatic bin estimator.

pub histogram_estimator(array: ndarray.Array, estimator: HistogramEstimator, density: Bool = false): List[ndarray.Array].

/// Builds an estimator-selected histogram over an explicit finite range.

pub histogram_estimator_range(array: ndarray.Array, estimator: HistogramEstimator, lower: Float, upper: Float, density: Bool = false): List[ndarray.Array].

/// Builds a one-dimensional histogram over an explicit finite range.

pub histogram_range(array: ndarray.Array, bins: Int, lower: Float, upper: Float, density: Bool = false): List[ndarray.Array].

/// Builds a weighted histogram with an inferred finite range.

pub histogram_weighted(array: ndarray.Array, weights: ndarray.Array, bins: Int = 10, density: Bool = false): List[ndarray.Array].

/// Builds a weighted histogram from explicit increasing edges.

pub histogram_weighted_edges(array: ndarray.Array, weights: ndarray.Array, edges: ndarray.Array, density: Bool = false): List[ndarray.Array].

/// Builds a weighted histogram over an explicit finite range.

pub histogram_weighted_range(array: ndarray.Array, weights: ndarray.Array, bins: Int, lower: Float, upper: Float, density: Bool = false): List[ndarray.Array].

/// Builds a multidimensional histogram with one inferred-range bin count.

pub histogramdd(samples: ndarray.Array, bins: Int = 10, density: Bool = false): List[ndarray.Array].

/// Builds a multidimensional histogram from one bin count per axis.

pub histogramdd_bins(samples: ndarray.Array, bins: List[Int], density: Bool = false): List[ndarray.Array].

/// Builds a multidimensional histogram from explicit edge vectors.

pub histogramdd_edges(samples: ndarray.Array, edges: List[ndarray.Array], density: Bool = false): List[ndarray.Array].

/// Builds a multidimensional histogram from per-axis counts and ranges.

pub histogramdd_range(samples: ndarray.Array, bins: List[Int], minima: List[Float], maxima: List[Float], density: Bool = false): List[ndarray.Array].

/// Builds a weighted multidimensional histogram with one inferred-range bin count.

pub histogramdd_weighted(samples: ndarray.Array, weights: ndarray.Array, bins: Int = 10, density: Bool = false): List[ndarray.Array].

/// Builds a weighted multidimensional histogram from one bin count per axis.

pub histogramdd_weighted_bins(samples: ndarray.Array, weights: ndarray.Array, bins: List[Int], density: Bool = false): List[ndarray.Array].

/// Builds a weighted multidimensional histogram from explicit edge vectors.

pub histogramdd_weighted_edges(samples: ndarray.Array, weights: ndarray.Array, edges: List[ndarray.Array], density: Bool = false): List[ndarray.Array].

/// Builds a weighted multidimensional histogram from per-axis ranges.

pub histogramdd_weighted_range(samples: ndarray.Array, weights: ndarray.Array, bins: List[Int], minima: List[Float], maxima: List[Float], density: Bool = false): List[ndarray.Array].

/// Provides NumPy-compatible hsplit behavior.

pub hsplit(array: ndarray.Array, sections: Int): List[ndarray.Array].

/// Provides NumPy-compatible hstack behavior.

pub hstack(arrays: List[ndarray.Array]): ndarray.Array.

/// Provides NumPy-compatible i0 behavior.

pub i0(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible imag behavior.

pub imag(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible insert behavior.

pub insert(array: ndarray.Array, index: Int, values: ndarray.Array): ndarray.Array.

/// Inserts values before stable flattened integer-index positions.

pub insert(array: ndarray.Array, indexes: List[Int], values: ndarray.Array): ndarray.Array.

/// Inserts values before one scalar index along a normalized axis.

pub insert(array: ndarray.Array, index: Int, values: ndarray.Array, axis: Int): ndarray.Array.

/// Inserts values before stable integer-index positions along a normalized axis.

pub insert(array: ndarray.Array, indexes: List[Int], values: ndarray.Array, axis: Int): ndarray.Array.

/// Returns whether two or more logical indexes in one strided array address the same element.

pub internal_overlap(array: ndarray.Array): Bool.

/// Interpolates with explicit real or complex scalar boundary arrays.

pub interpolate_boundaries(values: ndarray.Array, coordinates: ndarray.Array, samples: ndarray.Array, left: ndarray.Array, right: ndarray.Array): ndarray.Array.

/// Interpolates with the first and last samples as the default boundaries.

pub interpolate_default(values: ndarray.Array, coordinates: ndarray.Array, samples: ndarray.Array): ndarray.Array.

/// Interpolates over normalized and sorted periodic coordinates.

pub interpolate_periodic(values: ndarray.Array, coordinates: ndarray.Array, samples: ndarray.Array, period: Float): ndarray.Array.

/// Provides NumPy-compatible invert behavior.

pub invert(array: ndarray.Array): ndarray.Array.

/// Applies unbuffered bitwise inversion at rank-one integer indexes after stabilizing aliased indexes.

pub invert_at(array: ndarray.Array, indexes: ndarray.Array): Unit.

/// Writes bitwise inversion into an exact-shape destination after staging aliased input.

pub invert_into(destination: ndarray.Array, array: ndarray.Array): Unit.

/// Writes bitwise inversion where a Bool mask is true and stages masks that alias the destination.

pub invert_where_into(destination: ndarray.Array, array: ndarray.Array, mask: ndarray.Array): Unit.

/// Returns elementwise NumPy-compatible closeness.

pub isclose(lhs: ndarray.Array, rhs: ndarray.Array, relative_tolerance: Float, absolute_tolerance: Float, equal_nan: Bool): ndarray.Array.

/// Provides NumPy-compatible iscomplex behavior.

pub iscomplex(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible iscomplexobj behavior.

pub iscomplexobj(array: ndarray.Array): Bool.

/// Provides NumPy-compatible isneginf behavior.

pub isneginf(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible isposinf behavior.

pub isposinf(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible isreal behavior.

pub isreal(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible isrealobj behavior.

pub isrealobj(array: ndarray.Array): Bool.

/// Provides NumPy-compatible ix  behavior.

pub ix_(first: ndarray.Array, remaining: List[ndarray.Array]): List[ndarray.Array].

/// Provides NumPy-compatible kaiser behavior.

pub kaiser(length: Int, beta: Float): ndarray.Array.

/// Provides NumPy-compatible ldexp behavior.

pub ldexp(values: ndarray.Array, exponents: ndarray.Array): ndarray.Array.

/// Returns stable lexicographic indexes for stacked keys along one normalized key axis, using the final key as primary.

pub lexsort(keys: ndarray.Array, axis: Int): ndarray.Array.

/// Writes broadcast truth-value conjunction into an exact-shape Bool destination.

pub logical_and_into(destination: ndarray.Array, lhs: ndarray.Array, rhs: ndarray.Array): Unit.

/// Writes truth-value negation into an exact-shape Bool destination.

pub logical_not_into(destination: ndarray.Array, array: ndarray.Array): Unit.

/// Writes broadcast truth-value disjunction into an exact-shape Bool destination.

pub logical_or_into(destination: ndarray.Array, lhs: ndarray.Array, rhs: ndarray.Array): Unit.

/// Writes broadcast truth-value exclusive disjunction into an exact-shape Bool destination.

pub logical_xor_into(destination: ndarray.Array, lhs: ndarray.Array, rhs: ndarray.Array): Unit.

/// Returns parity reductions of truthy values over selected axes.

pub logical_xor_reduce(array: ndarray.Array, axes: List[Int], keep_dims: Int): ndarray.Array.

/// Returns square-matrix coordinates selected by a typed triangular mask.

pub mask_indices(size: Int, mask: TriangleMask, offset: Int = 0): ndarray.Array.

/// Provides NumPy-compatible may share memory behavior.

pub may_share_memory(lhs: ndarray.Array, rhs: ndarray.Array): Bool.

/// Returns an exact overlap answer within a work budget and conservatively returns true when the budget is exhausted; zero selects the bounds-only query and negative one selects unlimited exact work.

pub may_share_memory_with_work(lhs: ndarray.Array, rhs: ndarray.Array, max_work: Int): Bool.

/// Atomically writes a median into an exactly shaped writable destination.

pub median_into(destination: ndarray.Array, array: ndarray.Array, axes: List[Int], keep_dims: Int): Unit.

/// Returns an empty coordinate-grid list for an empty input sequence.

@pure
pub meshgrid(): List[ndarray.Array].

/// Builds coordinate grids while preserving each input dtype and explicit sparse/copy semantics.

pub meshgrid(first: ndarray.Array, remaining: List[ndarray.Array], indexing: MeshIndexing = MeshIndexing.XY, sparse: Bool = false, copy: Bool = true): List[ndarray.Array].

/// Provides NumPy-compatible msort behavior.

pub msort(array: ndarray.Array): ndarray.Array.

/// Provides NumPy-compatible nan to num behavior.

pub nan_to_num(array: ndarray.Array, nan: Float, positive_infinity: Float, negative_infinity: Float): ndarray.Array.

/// Replaces NaN and infinity components with dtype-specific finite defaults.

pub nan_to_num_default(array: ndarray.Array): ndarray.Array.

/// Writes non-finite replacements into an exact-shape, exact-dtype destination.

pub nan_to_num_into(destination: ndarray.Array, array: ndarray.Array, nan: Float, positive_infinity: Float, negative_infinity: Float): Unit.

/// Provides NumPy-compatible nanargmax behavior.

pub nanargmax(array: ndarray.Array): Int.

/// Returns maximum indexes over normalized axes while omitting NaNs.

pub nanargmax_axes(array: ndarray.Array, axes: List[Int], keep_dims: Bool): ndarray.Array.

/// Provides NumPy-compatible nanargmin behavior.

pub nanargmin(array: ndarray.Array): Int.

/// Returns minimum indexes over normalized axes while omitting NaNs.

pub nanargmin_axes(array: ndarray.Array, axes: List[Int], keep_dims: Bool): ndarray.Array.

/// Provides NumPy-compatible nancumprod behavior.

pub nancumprod(array: ndarray.Array, axis: Int): ndarray.Array.

/// Returns a NaN-normalized cumulative product in an explicit dtype.

pub nancumprod_as(array: ndarray.Array, axis: Int, requested_dtype: Int): ndarray.Array.

/// Returns a flattened cumulative product with NaNs replaced by one.

pub nancumprod_flat(array: ndarray.Array): ndarray.Array.

/// Writes a flattened NaN-normalized cumulative product into a vector destination.

pub nancumprod_flat_into(destination: ndarray.Array, array: ndarray.Array): Unit.

/// Writes a NaN-normalized cumulative product into an exact-shape destination.

pub nancumprod_into(destination: ndarray.Array, array: ndarray.Array, axis: Int): Unit.

/// Provides NumPy-compatible nancumsum behavior.

pub nancumsum(array: ndarray.Array, axis: Int): ndarray.Array.

/// Returns a NaN-normalized cumulative sum in an explicit dtype.

pub nancumsum_as(array: ndarray.Array, axis: Int, requested_dtype: Int): ndarray.Array.

/// Returns a flattened cumulative sum with NaNs replaced by zero.

pub nancumsum_flat(array: ndarray.Array): ndarray.Array.

/// Writes a flattened NaN-normalized cumulative sum into a vector destination.

pub nancumsum_flat_into(destination: ndarray.Array, array: ndarray.Array): Unit.

/// Writes a NaN-normalized cumulative sum into an exact-shape destination.

pub nancumsum_into(destination: ndarray.Array, array: ndarray.Array, axis: Int): Unit.

/// Returns maxima while omitting NaN values.

pub nanmax(array: ndarray.Array, axes: List[Int], keep_dims: Bool): ndarray.Array.

/// Writes NaN-omitting maxima into an exact-shape destination.

pub nanmax_into(destination: ndarray.Array, array: ndarray.Array, axes: List[Int], keep_dims: Bool): Unit.

/// Returns means while omitting NaN values.

pub nanmean(array: ndarray.Array, axes: List[Int], keep_dims: Bool): ndarray.Array.

/// Returns NaN-omitting means in an explicit inexact dtype.

pub nanmean_as(array: ndarray.Array, axes: List[Int], keep_dims: Bool, dtype: Int): ndarray.Array.

/// Writes NaN-omitting means into an exact-shape inexact destination.

pub nanmean_into(destination: ndarray.Array, array: ndarray.Array, axes: List[Int], keep_dims: Bool): Unit.

/// Provides NumPy-compatible nanmedian behavior.

pub nanmedian(array: ndarray.Array): ndarray.Array.

/// Returns a NaN-skipping median across normalized axes.

pub nanmedian_axes(array: ndarray.Array, axes: List[Int], keep_dims: Int): ndarray.Array.

/// Atomically writes a NaN-skipping median into an exactly shaped writable destination.

pub nanmedian_into(destination: ndarray.Array, array: ndarray.Array, axes: List[Int], keep_dims: Int): Unit.

/// Returns minima while omitting NaN values.

pub nanmin(array: ndarray.Array, axes: List[Int], keep_dims: Bool): ndarray.Array.

/// Writes NaN-omitting minima into an exact-shape destination.

pub nanmin_into(destination: ndarray.Array, array: ndarray.Array, axes: List[Int], keep_dims: Bool): Unit.

/// Provides NumPy-compatible nanpercentile behavior.

pub nanpercentile(array: ndarray.Array, percentile: Float): ndarray.Array.

/// Returns one NaN-skipping percentile across normalized axes.

pub nanpercentile_axes(array: ndarray.Array, percentile: Float, axes: List[Int], keep_dims: Int, interpolation: Int): ndarray.Array.

/// Atomically writes one NaN-skipping percentile into an exactly shaped writable destination.

pub nanpercentile_into(destination: ndarray.Array, array: ndarray.Array, percentile: Float, axes: List[Int], keep_dims: Int, interpolation: Int): Unit.

/// Returns multiple NaN-skipping percentiles with the percentile dimension first.

pub nanpercentiles(array: ndarray.Array, percentiles: List[Float], axes: List[Int], keep_dims: Int, interpolation: Int): ndarray.Array.

/// Atomically writes multiple NaN-skipping percentiles into an exactly shaped writable destination.

pub nanpercentiles_into(destination: ndarray.Array, array: ndarray.Array, percentiles: List[Float], axes: List[Int], keep_dims: Int, interpolation: Int): Unit.

/// Returns products while omitting NaN values.

pub nanprod(array: ndarray.Array, axes: List[Int], keep_dims: Bool): ndarray.Array.

/// Returns NaN-omitting products in an explicit dtype.

pub nanprod_as(array: ndarray.Array, axes: List[Int], keep_dims: Bool, dtype: Int): ndarray.Array.

/// Writes NaN-omitting products into an exact-shape destination.

pub nanprod_into(destination: ndarray.Array, array: ndarray.Array, axes: List[Int], keep_dims: Bool): Unit.

/// Provides NumPy-compatible nanquantile behavior.

pub nanquantile(array: ndarray.Array, quantile: Float): ndarray.Array.

/// Returns one NaN-skipping quantile across normalized axes.

pub nanquantile_axes(array: ndarray.Array, quantile: Float, axes: List[Int], keep_dims: Int, interpolation: Int): ndarray.Array.

/// Atomically writes one NaN-skipping quantile into an exactly shaped writable destination.

pub nanquantile_into(destination: ndarray.Array, array: ndarray.Array, quantile: Float, axes: List[Int], keep_dims: Int, interpolation: Int): Unit.

/// Returns multiple NaN-skipping quantiles with the quantile dimension first.

pub nanquantiles(array: ndarray.Array, quantiles: List[Float], axes: List[Int], keep_dims: Int, interpolation: Int): ndarray.Array.

/// Atomically writes multiple NaN-skipping quantiles into an exactly shaped writable destination.

pub nanquantiles_into(destination: ndarray.Array, array: ndarray.Array, quantiles: List[Float], axes: List[Int], keep_dims: Int, interpolation: Int): Unit.

/// Returns standard deviation while omitting NaN values.

pub nanstd(array: ndarray.Array, axes: List[Int], keep_dims: Bool, correction: Int): ndarray.Array.

/// Returns NaN-omitting standard deviations in an explicit inexact dtype.

pub nanstd_as(array: ndarray.Array, axes: List[Int], keep_dims: Bool, correction: Int, dtype: Int): ndarray.Array.

/// Writes NaN-omitting standard deviations into an exact-shape inexact destination.

pub nanstd_into(destination: ndarray.Array, array: ndarray.Array, axes: List[Int], keep_dims: Bool, correction: Int): Unit.

/// Returns sums while omitting NaN values.

pub nansum(array: ndarray.Array, axes: List[Int], keep_dims: Bool): ndarray.Array.

/// Returns NaN-omitting sums in an explicit dtype.

pub nansum_as(array: ndarray.Array, axes: List[Int], keep_dims: Bool, dtype: Int): ndarray.Array.

/// Writes NaN-omitting sums into an exact-shape destination.

pub nansum_into(destination: ndarray.Array, array: ndarray.Array, axes: List[Int], keep_dims: Bool): Unit.

/// Returns variance while omitting NaN values.

pub nanvar(array: ndarray.Array, axes: List[Int], keep_dims: Bool, correction: Int): ndarray.Array.

/// Returns NaN-omitting variances in an explicit inexact dtype.

pub nanvar_as(array: ndarray.Array, axes: List[Int], keep_dims: Bool, correction: Int, dtype: Int): ndarray.Array.

/// Writes NaN-omitting variances into an exact-shape inexact destination.

pub nanvar_into(destination: ndarray.Array, array: ndarray.Array, axes: List[Int], keep_dims: Bool, correction: Int): Unit.

