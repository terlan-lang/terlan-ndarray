//! Polynomial evaluation, fitting, arithmetic, roots, calculus, and basis conversion.

module ndarray.Polynomial.

/// Adds two low-to-high polynomial coefficient vectors.

pub polyadd(lhs: ndarray.Array, rhs: ndarray.Array): ndarray.Array.

/// Returns the power-basis companion matrix used for root finding.

pub polycompanion(coefficients: ndarray.Array): ndarray.Array.

/// Converts coefficients among power, Chebyshev, and Legendre bases over a finite domain and window.

pub polyconvert(coefficients: ndarray.Array, source_basis: Int, target_basis: Int, domain_minimum: Float, domain_maximum: Float, window_minimum: Float, window_maximum: Float): ndarray.Array.

/// Differentiates low-to-high polynomial coefficients by a nonnegative order.

pub polyder(coefficients: ndarray.Array, order: Int): ndarray.Array.

/// Differentiates tensor coefficients along one axis with linear-variable scaling.

pub polyder_axis(coefficients: ndarray.Array, order: Int, scale: Float, axis: Int): ndarray.Array.

/// Returns polynomial quotient and remainder as two owned arrays.

pub polydiv_all(lhs: ndarray.Array, rhs: ndarray.Array): List[ndarray.Array].

/// Fits low-to-high power-basis coefficients by finite SVD least squares.

pub polyfit(coordinates: ndarray.Array, values: ndarray.Array, degree: Int): ndarray.Array.

/// Fits contiguous power degrees and returns coefficients plus scaled or unscaled covariance.

pub polyfit_covariance(coordinates: ndarray.Array, values: ndarray.Array, degree: Int, scale_covariance: Bool): List[ndarray.Array].

/// Fits selected power-basis degrees to vector or matrix observations.

pub polyfit_degrees(coordinates: ndarray.Array, values: ndarray.Array, degrees: ndarray.Array): ndarray.Array.

/// Fits weighted contiguous power degrees and returns coefficients plus scaled or unscaled covariance.

pub polyfit_weighted_covariance(coordinates: ndarray.Array, values: ndarray.Array, degree: Int, weights: ndarray.Array, scale_covariance: Bool): List[ndarray.Array].

/// Fits selected power-basis degrees with one weight per observation.

pub polyfit_weighted_degrees(coordinates: ndarray.Array, values: ndarray.Array, degrees: ndarray.Array, weights: ndarray.Array): ndarray.Array.

/// Returns low-to-high coefficients for a monic polynomial with the supplied roots.

pub polyfromroots(roots: ndarray.Array): ndarray.Array.

/// Evaluates a two-dimensional coefficient grid over a Cartesian product.

pub polygrid2d(x: ndarray.Array, y: ndarray.Array, coefficients: ndarray.Array): ndarray.Array.

/// Evaluates a three-dimensional coefficient grid over a Cartesian product.

pub polygrid3d(x: ndarray.Array, y: ndarray.Array, z: ndarray.Array, coefficients: ndarray.Array): ndarray.Array.

/// Integrates low-to-high polynomial coefficients with a repeated constant.

pub polyint(coefficients: ndarray.Array, order: Int, constant: Float): ndarray.Array.

/// Integrates tensor coefficients along one axis with per-order constants, a lower bound, and scaling.

pub polyint_axis(coefficients: ndarray.Array, order: Int, constants: ndarray.Array, lower_bound: Float, scale: Float, axis: Int): ndarray.Array.

/// Returns coefficients for offset plus scale times x.

pub polyline(offset: Float, scale: Float): ndarray.Array.

/// Multiplies two low-to-high polynomial coefficient vectors.

pub polymul(lhs: ndarray.Array, rhs: ndarray.Array): ndarray.Array.

/// Multiplies a coefficient vector by x.

pub polymulx(coefficients: ndarray.Array): ndarray.Array.

/// Raises a coefficient vector to a nonnegative integer power.

pub polypow(coefficients: ndarray.Array, exponent: Int): ndarray.Array.

/// Returns all complex roots of a finite nonconstant power-basis polynomial.

pub polyroots(coefficients: ndarray.Array): ndarray.Array.

/// Subtracts two low-to-high polynomial coefficient vectors.

pub polysub(lhs: ndarray.Array, rhs: ndarray.Array): ndarray.Array.

/// Removes redundant leading coefficients under a tolerance.

pub polytrim(coefficients: ndarray.Array, tolerance: Float): ndarray.Array.

/// Evaluates low-to-high power-basis coefficients at every coordinate.

pub polyval(coordinates: ndarray.Array, coefficients: ndarray.Array): ndarray.Array.

/// Evaluates a two-dimensional coefficient grid over broadcast coordinates.

pub polyval2d(x: ndarray.Array, y: ndarray.Array, coefficients: ndarray.Array): ndarray.Array.

/// Evaluates a three-dimensional coefficient grid over broadcast coordinates.

pub polyval3d(x: ndarray.Array, y: ndarray.Array, z: ndarray.Array, coefficients: ndarray.Array): ndarray.Array.

/// Evaluates a monic polynomial directly from roots.

pub polyvalfromroots(coordinates: ndarray.Array, roots: ndarray.Array): ndarray.Array.

/// Evaluates root-defined polynomial tensors in Cartesian or broadcast mode.

pub polyvalfromroots_tensor(coordinates: ndarray.Array, roots: ndarray.Array, tensor: Bool): ndarray.Array.

/// Builds a power Vandermonde matrix with columns from degree zero upward.

pub polyvander(coordinates: ndarray.Array, degree: Int): ndarray.Array.

/// Builds a two-dimensional broadcast power Vandermonde matrix.

pub polyvander2d(x: ndarray.Array, y: ndarray.Array, x_degree: Int, y_degree: Int): ndarray.Array.

/// Builds a three-dimensional broadcast power Vandermonde matrix.

pub polyvander3d(x: ndarray.Array, y: ndarray.Array, z: ndarray.Array, x_degree: Int, y_degree: Int, z_degree: Int): ndarray.Array.
