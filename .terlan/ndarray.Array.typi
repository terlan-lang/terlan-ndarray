pub variance_as(array: Array, axes: List[Int], keep_dims: Int, correction: Int, dtype: Int): Array.

/// Writes variances into an exactly shaped writable destination.

pub variance_into(destination: Array, array: Array, axes: List[Int], keep_dims: Int, correction: Int): Unit.

/// Returns variances over elements selected by a broadcast-compatible truth mask.

pub variance_where(array: Array, mask: Array, axes: List[Int], keep_dims: Int, correction: Int): Array.

