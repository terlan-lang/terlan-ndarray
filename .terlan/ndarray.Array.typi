pub trace(array: Array, offset: Int, axis_a: Int, axis_b: Int): Array.

/// Computes a diagonal sum and atomically writes it into an exactly shaped destination.

pub trace_into(destination: Array, array: Array, offset: Int, axis_a: Int, axis_b: Int): Unit.

/// Returns a shared strided view with two normalized axes exchanged.

pub transpose(array: Array, axis_a: Int, axis_b: Int): Array.

