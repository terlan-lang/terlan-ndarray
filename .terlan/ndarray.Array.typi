pub searchsorted(sorted: Array, values: Array, right: Bool): Array.

/// Returns insertion indexes using a validated Int64 permutation of an unsorted rank-one array.

pub searchsorted_with_sorter(array: Array, values: Array, sorter: Array, right: Bool): Array.

/// Selects promoted branch values through a broadcast-compatible truth-value condition.

pub select_where(mask: Array, selected: Array, rejected: Array): Array.

/// Encodes an array as a versioned checksummed package-native packet.

pub serialize(array: Array): std.vm.Bytes.

