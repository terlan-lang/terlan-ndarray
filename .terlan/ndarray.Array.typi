pub mmap_npy(path: String, writable: Bool, maximum: Int): Array.

/// Returns fractional and integral-part arrays.

pub modf_all(array: Array): List[Array].

/// Multiplies broadcast-compatible numeric arrays with canonical dtype promotion.

pub multiply(lhs: Array, rhs: Array): Array.

/// Returns maxima while omitting NaN values.

pub nan_maximum(array: Array, axes: List[Int], keep_dims: Int): Array.

/// Returns means while omitting NaN values.

pub nan_mean(array: Array, axes: List[Int], keep_dims: Int): Array.

/// Returns minima while omitting NaN values.

