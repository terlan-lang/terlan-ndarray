//! NumPy-compatible array creation and triangular matrix operations.

module ndarray.Creation.

/// Owns the samples and broadcast-shaped step returned by a linspace call.

pub struct LinspaceWithStep {
    samples: ndarray.Array.Array,
    step: ndarray.Array.Array
}.

/// Flattens an array and places its values on an indexed diagonal of a new square matrix.

pub diagflat(array: ndarray.Array.Array, diagonal: Int): ndarray.Array.Array.

/// Allocates an uninitialized array with the source shape and dtype.

pub empty_like(array: ndarray.Array.Array): ndarray.Array.Array.

/// Creates a diagonal-unit matrix with NumPy-compatible defaults.

pub eye(rows: Int, columns: Int = - 1, diagonal: Int = 0, dtype: Int = 3, order: ndarray.Array.ArrayOrder = ArrayOrder.C): ndarray.Array.Array.

/// Creates a rectangular diagonal-unit matrix with explicit C or Fortran storage order.

pub eye_ordered(rows: Int, columns: Int, diagonal: Int, dtype: Int, order: Int): ndarray.Array.Array.

/// Fills a new source-shaped and source-typed array with a floating scalar.

pub full_like_float(array: ndarray.Array.Array, value: Float): ndarray.Array.Array.

/// Fills a new source-shaped and source-typed array with an integer scalar.

pub full_like_int(array: ndarray.Array.Array, value: Int): ndarray.Array.Array.

/// Returns evenly spaced values on a same-sign geometric progression.

pub geomspace(start: Float, stop: Float, count: Int, endpoint: Int, dtype: Int): ndarray.Array.Array.

/// Broadcasts nonzero endpoints and inserts geometrically spaced samples at the requested axis.

pub geomspace_arrays(start: ndarray.Array.Array, stop: ndarray.Array.Array, count: Int, endpoint: Int, axis: Int, dtype: Int): ndarray.Array.Array.

/// Returns one dense numeric coordinate grid for every dimension of a shape.

pub indices(shape: List[Int], dtype: Int): ndarray.Array.Array.

/// Returns one sparse numeric coordinate grid per dimension, with singleton dimensions elsewhere.

pub indices_sparse(shape: List[Int], dtype: Int): List[ndarray.Array.Array].

/// Broadcasts numerical endpoint arrays and inserts evenly spaced samples at the requested axis.

pub linspace_arrays(start: ndarray.Array.Array, stop: ndarray.Array.Array, count: Int, endpoint: Int, axis: Int, dtype: Int): ndarray.Array.Array.

/// Returns the broadcast-shaped spacing for array endpoints, including NaN for an undefined spacing.

pub linspace_steps(start: ndarray.Array.Array, stop: ndarray.Array.Array, count: Int, endpoint: Int): ndarray.Array.Array.

/// Returns evenly spaced samples together with their broadcast-shaped step.

pub linspace_with_step(start: ndarray.Array.Array, stop: ndarray.Array.Array, count: Int, endpoint: Int, axis: Int, dtype: Int): LinspaceWithStep.

/// Returns powers of a positive base with evenly spaced exponents.

pub logspace(start: Float, stop: Float, count: Int, endpoint: Int, base: Float, dtype: Int): ndarray.Array.Array.

/// Broadcasts exponent arrays and inserts powers of a positive base at the requested axis.

pub logspace_arrays(start: ndarray.Array.Array, stop: ndarray.Array.Array, count: Int, endpoint: Int, axis: Int, base: Float, dtype: Int): ndarray.Array.Array.

/// Allocates a one-filled array with the source shape and dtype.

pub ones_like(array: ndarray.Array.Array): ndarray.Array.Array.

/// Creates a matrix with ones at and below an indexed diagonal.

pub tri(rows: Int, columns: Int = - 1, diagonal: Int = 0, dtype: Int = 3): ndarray.Array.Array.

/// Copies an array while zeroing entries above an indexed diagonal in every matrix plane.

pub tril(array: ndarray.Array.Array, diagonal: Int = 0): ndarray.Array.Array.

/// Copies an array while zeroing entries below an indexed diagonal in every matrix plane.

pub triu(array: ndarray.Array.Array, diagonal: Int = 0): ndarray.Array.Array.

/// Builds a Vandermonde matrix with explicit column count and exponent order.

pub vander(array: ndarray.Array.Array, columns: Int, increasing: Int): ndarray.Array.Array.

/// Allocates a zero-filled array with the source shape and dtype.

pub zeros_like(array: ndarray.Array.Array): ndarray.Array.Array.
